# Copy this file to .env and fill in real values. .env is gitignored so
# secrets never get committed; scripts/emergnn-run.sh auto-loads it if present.
#
# Only secrets / machine-local settings go here. Run metadata (dataset, seed,
# gpu, wandb entity/project/name) is passed as args/env vars at invocation
# time instead - see scripts/emergnn-run.sh.

# https://wandb.ai/authorize
WANDB_API_KEY=

# online (default) logs straight to wandb.ai; offline logs locally and needs
# a later `wandb sync` (useful if the rented server has no outbound network
# during training).
WANDB_MODE=online
